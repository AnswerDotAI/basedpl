  }
  vec←{
    0≡⍵:⍬
    key_val bal(lft rgt)←⍵
    (∇ lft),(⊂key_val),∇ rgt
  }
  chk←{
    0=≡⍵:(0≡⍵)0 0 0,⍬ 1 1
