⍝ april/libraries/dfns/graph/demo.lisp:14 —
assign ← {
  step0←{step1(⌽⌈\⌽⍴⍵)↑⍵}
  step1←{step2↑(↓⍵)-⌊/⍵}
  step2←{
    stars←{
      ~1∊⍵:⍺
      next←<\<⍀⍵
      mask←(rows next)∨cols next
      (⍺∨next)∇ ⍵>mask
    }
    zeros←{⍵+0 stars ⍵}⍵=0
    step3 ⍵ zeros
  }
  step3←{costs zeros←⍵
    stars←zeros=2
    covers←2×cols stars
    ~0∊covers:stars
    step4 costs zeros covers
  }
  step4←{costs zeros covers←⍵
    mask←covers=0
    open←1=mask×zeros
    ~1∊open:(⌊/(,mask)/,costs)step6 ⍵
    prime←first open
    prow←rows prime
    star←2=zeros×prow
    ~1∊star:prime step5{
      costs ⍵ prime
    }zeros+2×prime
    cnext←covers+prow-2×cols star
    znext←zeros⌈3×prime
    ∇ costs znext cnext
  }
  step5←{costs zeros prime←⍵
    star←(cols prime)∧zeros=2
    ~1∊star:step3 ⍺{
      {costs ⍵}{⍵-2×⍵=3}⍵-⍺∧⍵>1
    }zeros
    pnext←(rows star)∧zeros=3
    (⍺∨pnext∨star)∇ costs zeros pnext
  }
  step6←{costs zeros covers←⍵
    cnext←costs+⍺×¯1 1+.×0 3∘.=covers
    znext←zeros+(×costs)-×cnext
    step4 cnext znext covers
  }
  rows←{(⍴⍵)⍴(⊃⌽⍴⍵)/∨/⍵}
  cols←{(⍴⍵)⍴∨⌿⍵}
  first←{(⍴⍵)⍴<\,⍵}
  (⍴⍵)↑step0 ⍵
}
costs1 ← ↑(72 99 88)(23 30 35)(51 59 84)
assign costs1
⍝ =>
3 3⍴1 0 0 0 0 1 0 1 0

