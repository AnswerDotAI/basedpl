⍝ april/libraries/dfns/string/demo.lisp:283 — Origin-1 justify indices and split counts; original April expectation retained
justify ← { 
  segs←{¯1+⍵{(⍵,⍴⍺)-¯1,⍵}¯1+⍸⍵}
  split←{((⍵|⍺)>¯1+⍳⍵)+⌊⍺÷1⌈⍵}
  lf sp←(⎕UCS 10 32)=⊂⍵
  sizes←segs lf
  ⍺←⌈/sizes
  blanks←segs~(lf∨sp)/sp
  required←blanks+⍺-sizes
  breps←required split¨blanks
  last←1⌈¯1+⍴sizes
  brep←∊(last↑breps),×last↓breps
  ((~sp)+sp\∊brep)\⍵
}
subs ← {
  fs ts←≢¨fm to←⍺
  1≡≡⍺:to@(fm∘=)⍵
  0=⍴⍴⍵:⊃(⍵≡fm)⌽⍵(⊂to)
  lead←fs↑1
  (fm⍷⍵){
    ~1∊⍺:⍵
    ts↓↑,/{to,fs↓⍵}¨(lead,⍺)⊂fm,⍵
  }⍤1⊢⍵
}
