    ~0∊covers:stars
    step4 costs zeros covers
  }
  step4←{costs zeros covers←⍵
    mask←covers=0
    open←1=mask×zeros
    ~1∊open:(⌊/(,mask)/,costs)step6 ⍵
    prime←first open
