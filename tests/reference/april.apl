⍝ april/libraries/dfns/graph/demo.lisp:72 —
span ← {
  graph←⍺
  (¯2+(⍳⍴⍺)∊⍵){
    ⍵≡⍬:⍺
    next←graph[⍵]∩¨⊂⍸⍺=¯2
    back←⍵+0×next
    tree←(∊back)@(∊next)⊢⍺
    tree ∇∪∊next
  }⍵
}
stdists ← {
  tree←⍵
  0{
    next dvec←⍵
    next≡⍬:dvec
    ∆dvec←⍺@next⊢dvec
    ∆next←⍸tree∊next
    (⍺+1)∇ ∆next ∆dvec
  }(⍵⍳¯1)(⍵⊢¨¯1)
}
g ← (2 3) (3) (2 4) (1 5) (3)
stdists¨g∘span¨⍳⍴g
⍝ =>
(0 1 1 2 3) (3 0 1 2 3) (2 1 0 1 2) (1 2 2 0 1) (3 2 1 2 0)

⍝ april/libraries/dfns/graph/demo.lisp:73 —
span ← {
  graph←⍺
  (¯2+(⍳⍴⍺)∊⍵){
    ⍵≡⍬:⍺
    next←graph[⍵]∩¨⊂⍸⍺=¯2
    back←⍵+0×next
    tree←(∊back)@(∊next)⊢⍺
    tree ∇∪∊next
  }⍵
}
stpath ← {
  tree←⍺
  ⍬{
    ⍵<0:(⍵=¯2)↓⍺
    (⍵,⍺)∇ ⍵⊃tree
  }⍵
}
g ← (2 3) (3) (2 4) (1 5) (3)
(g span 3)∘stpath¨⍳5
