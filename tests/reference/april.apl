  1↓¨⍺{
    (⍵∊⍺)⊂⍵
  }¯1⌽⍵,(~(¯1↑⍵)∊⍺)/1↑⍺
}
(⊂'and')ltov 'red' 'and' 'yellow' ',' 'pink' 'and' 'green'
⍝ =>
(1⍴⊂('red')) (('yellow') ',' ('pink')) (1⍴⊂('green'))

