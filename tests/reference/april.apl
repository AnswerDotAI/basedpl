    lax←'│⌽↓'[1+¯1↓1↓⍺],¨⊂vrt
    lft←⍉'┌',(↑lax),'└'
    lft,(top⍪⍵⍪bot),rgt
  }
  deco←{⍺←type open ⍵ ⋄ ⍺,axes ⍵}
  axes←{(-2⌈⍴⍴⍵)↑1+×⍴⍵}
  open←{(1⌈⍴⍵)⍴⍵}
  trim←{(~1 1⍷∧⌿⍵=' ')/⍵}
  char←{⍬≡⍴⍵:'─' ⋄ (1+⊃⍵∊'¯',⎕D)⊃'#~'}∘⍕
