    cols←(1+×¯1↑⍴⍵)⊃'⊖→'
    rsig←(1+××/¯1↓⍴⍵)⊃'⌽↓'
    rows←(3⌊⍴⍴⍵)⊃'│'rsig'⍒'
    rows cols
  }
  matr←{↑,↓⍵}
  sepr←{+/¨1⊂↑⍵}
  open←{(⍺⌈⍴⍵)⍴⍵}
  isor←{1 ⍬≡(≡⍵)(⍴⍵)}
  glue←{0=⍴⍵ : ⍵ ⋄ ↑⍺{⍺,⍺⍺,⍵}/⍵}
  isor ⍵:format⊂⍵
  1=≡,⍵:format ⍵
  box ⍵
}
