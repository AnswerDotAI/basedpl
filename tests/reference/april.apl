⍝ april/libraries/dfns/string/demo.lisp:72 — Embedded display helper uses existing glyphs: origin-one offsets, character-prototype test instead of April ⎕TY, matrix ⍕ instead of ⎕FMT. Full example/setup retained
display ← { format←{t←↑,↓⍕⍵ ⋄ (¯2↑1 1,⍴t)⍴t} ⋄ 
  box←{
    vrt hrz←(¯1+⍴⍵)⍴¨'│─'
    top←'─⊖→'[1+¯1↑⍺],hrz
    bot←(⊃⍺),hrz
    rgt←'┐│',vrt,'┘'
    lax←'│⌽↓'[1+¯1↓1↓⍺],¨⊂vrt
    lft←⍉'┌',(↑lax),'└'
    lft,(top⍪⍵⍪bot),rgt
  }
  deco←{⍺←type open ⍵ ⋄ ⍺,axes ⍵}
  axes←{(-2⌈⍴⍴⍵)↑1+×⍴⍵}
  open←{(1⌈⍴⍵)⍴⍵}
  trim←{(~1 1⍷∧⌿⍵=' ')/⍵}
  char←{⍬≡⍴⍵:'─' ⋄ (1+⊃⍵∊'¯',⎕D)⊃'#~'}∘⍕
  type←{{(1+1=⍴⍵)⊃'+'⍵}∪,char¨⍵}
  line←{(1+''≡0⍴⍵)⊃' -'}
  { 
    0=≡⍵:' '⍪(open format ⍵)⍪line ⍵
    1 ⍬≡(≡⍵)(⍴⍵):'∇' 0 0 box format ⍵
    1=≡⍵:(deco ⍵)box open format open ⍵
    ('∊'deco ⍵)box trim format ∇¨open ⍵
  }⍵
}
