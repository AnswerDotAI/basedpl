  }
  sub←{
    inf red subs←⍺
    lft rgt←⍵ wise subs
    sub←⍺⍺ rgt
    inf red(⍵ wise lft sub)
    }
  isred←{
    inf col(lft rgt)←⍺
    ⍵≡⍬:col
    (⊃⌽(⊃⍵)wise lft rgt)∇ 1↓⍵
  }
  wise←{(2×⍺)↑3⍴⍵}
  flip←{kv b lr←⍵ ⋄ kv(~b)lr}
  done←{⍺ ⍵}∘0 0 0
  base←{⍺ ⍵}∘⍬
  dblk←{⍺ ⍵}∘(,0)
  op←⍺⍺
  '∪'≡op:root ⍺ ins ⍵
  '~'≡op:root ⍺ rem ⍵ 0
  '⍎'≡op:⍵ get ⍺
  '⍕'≡op:fmt ⍵
  '∊'≡op:vec ⍵
  '?'≡op:4↑0 chk ⍵
}
foldl ← { ↑⍺⍺⍨/(⌽⍵),⊂⍺ }
put←'∪' redblack ⋄ get←'⍎' redblack ⋄ rem←'~' redblack ⋄ fmt←'⍕' redblack ⋄ chk←'?' redblack ⋄ vec←'∊' redblack ⋄ tree←0∘(put foldl)
