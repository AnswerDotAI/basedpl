    (matr↑,¨/⍺)bot¨matr ⍵
  }
  type←{
    dec<|≡⍵:'─'
    isor ⍵:'∇'
    sst←{
      0=dec×⍴⍴⍵:'─'
      (1+⊃⍵∊'¯',⎕D)⊃'#~'
    }∘⍕
    0=≡⍵:sst ⍵
    {(1+1=⍴⍵)⊃'+'⍵}∪,sst¨dec open ⍵
  }
  shape←{     
    dec≤0=⍴⍴⍵:⍺/¨'│─'
    cols←(1+×¯1↑⍴⍵)⊃'⊖→'
    rsig←(1+××/¯1↓⍴⍵)⊃'⌽↓'
    rows←(3⌊⍴⍴⍵)⊃'│'rsig'⍒'
    rows cols
  }
  matr←{↑,↓⍵}
  sepr←{+/¨1⊂↑⍵}
  open←{(⍺⌈⍴⍵)⍴⍵}
  isor←{1 ⍬≡(≡⍵)(⍴⍵)}
  glue←{0=⍴⍵ : ⍵ ⋄ ↑⍺{⍺,⍺⍺,⍵}/⍵}
  isor ⍵:format⊂⍵
  1=≡,⍵:format ⍵
  box ⍵
}
