wrap2 ← { ⍺←102
  v←' ',⍵,' '
  j←(v=' ')/⍳⍴v
  p←(j+⍺+1)∘.<j
  m←p<1⌽p
  i←(⍴m)⍴1x,(1↓⍴m)⍴0x
  c←⌹i-m
  v[c[1;]/j]←⎕UCS 10
  1↓¯1↓v
}
