Cholesky ← {
  1≥n←≢⍵:⍵*0.5
  p←⌈n÷2
  q←⌊n÷2
  X←(p,p)↑⍵⊣Y←(p,-q)↑⍵⊣Z←(-q,q)↑⍵
  L0←∇ X
  L1←∇ Z-(TT←(+⍉Y)+.×⌹X)+.×Y
  ((p,n)↑L0)⍪(TT+.×L0),L1
}
