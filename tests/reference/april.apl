  dec ctd←2↑⍺
  box←{
    isor ⍵:format⊂⍵
    1=≡,⍵:dec open format dec open ⍵
    mat←matr 1/dec open ⍵
    r c←×⍴mat
    dec<0∊r c:c/r⌿∇ 1 open mat
    subs←aligned ∇¨mat
    (≢⍴⍵)gaps ⍵ plane subs
  }
  aligned←{
    rows cols←sepr⍴¨⍵
    sizes←(⌈/rows)∘.,⌈⌿cols
    ctd=0:sizes↑¨⍵
    v h←sepr⌈0.5×↑(⍴¨⍵)-sizes
    v⊖¨h⌽¨sizes↑¨⍵
  }
  gaps←{
    ⍺≤2:⍵
    subs←(⍺-1)∇¨⍵
    width←⊃⌽⍴⊃subs
    fill←(⍺ width-3 0)⍴' '
    ↑{⍺⍪fill⍪⍵}/1 open subs
  }
  plane←{
    2<⍴⍴⍺:⍺ join ⍵
    odec←(dec shape ⍺)outer ⍵
    idec←inner ⍺
    (odec,idec)collect ⍵
  }
  join←{
    sep←(≢⍵)÷1⌈≢⍺
    split←(0=sep|¯1+⍳≢⍵)⊂[1]⍵
    (⊂⍤¯1⊢⍺)plane¨split
  }
  outer←{
    sizes←1 0{⊃↓(⍉⍣⍺)⍵}¨sepr⍴¨⍵
    sides←sizes/¨¨'│─'
    bords←dec↓¨'├┬'glue¨sides
    ↑,¨/('┌' '')⍺ bords'└┐'
  }
  inner←{
    deco←{(type ⍵),1 shape ⍵}
    sepr deco¨matr dec open ⍵
  }
  collect←{
    lft top tt vv hh←⍺
    cells←vv right 1 open tt hh lower ⍵
    boxes←(dec∨0∊⍴⍵)open cells
    lft,top⍪↑⍪⌿,/boxes
  }
  right←{
    types←2⊥¨(⍳⍴⍵)=⊂⍴⍵
    chars←'┼┤┴┘'[1+types]
    rgt←{⍵,(-≢⍵)↑(≢⍵)1 1/'│',⍺}
    ((matr 1 open ⍺),¨chars)rgt¨⍵
  }
  lower←{
    split←{((¯2+2⊃⍴⍵)/'─')glue ⍺}
    bot←{⍵⍪(-2⊃⍴⍵)↑⍺ split ⍵}
    (matr↑,¨/⍺)bot¨matr ⍵
  }
  type←{
    dec<|≡⍵:'─'
    isor ⍵:'∇'
    sst←{
      0=dec×⍴⍴⍵:'─'
      (1+⊃⍵∊'¯',⎕D)⊃'#~'
    }∘⍕
    0=≡⍵:sst ⍵
    {(1+1=⍴⍵)⊃'+'⍵}∪,sst¨dec open ⍵
  }
  shape←{     
