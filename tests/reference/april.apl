  (⍺ ⍺⍺ head)∇ tail
}
vectFromList ← ⍬∘({⍺,⊂⍵} ltrav)
revl ← '∘'∘({⍺ ⍵}⍨ ltrav)
listRmDups ← {
  ⍺←'∘'
  (a(b tail))←⍵
  b≡'∘': revl a ⍺
  a≡b:⍺ ∇ b tail
  a ⍺ ∇ b tail
}
vectFromList listRmDups list 'Mississippi'
⍝ =>
'Misisipi'

⍝ april/libraries/dfns/array/demo.lisp:183 —
match ← {
  p x←{⍵'*'}⍣(1=≡,⍺),⍺
  v←1↓¨{(x≡¨⍵)⊂⍵}x,p
  h←↑v⍷¨⊂⍵
  r←0,¯1↓,↑⍴¨v
  sl←{
    a←¯1↓⍴⍵
    x←⌈/⍺
    p←⍵,(a,x)⍴0
    s←⍉a⍴⍺
    (-(0×a),x)↓s⌽p
  }
  m←⌽∨\⌽r sl h
  ↑⊃¨{
    (lh lm)(und rm)←⍺ ⍵
    (lh∧rm)lm
  }/↓⍉↑⊂⍤¯1¨h m
}
showmatch ← {,[⍳⍴⍴⍵]⍵,[¯0.5+⍴⍴⍵](' ¯'[1+⍺ match ⍵])}
↓'<<*>>' showmatch '<<>> <<aa>>'
⍝ =>
('<<>> <<aa>>') ('¯    ¯     ')

